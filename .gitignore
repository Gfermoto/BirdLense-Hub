# Deploy — локальные переопределения (IP, URL)
scripts/deploy.local.sh

# Deploy — никогда не коммитить
.deploy_credentials
*.pem
**/secrets/
**/*password*
**/*secret*

# Hugging Face — токены (hf_...) не должны попадать в репо
**/.cache/huggingface/

