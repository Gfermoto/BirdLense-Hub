# BirdLense Hub — один контейнер
# Go2RTC upstream — из video.go2rtc_url (http://IP:1984)

resolver 127.0.0.11 valid=10s ipv6=off;

upstream birdlense_web {
  server 127.0.0.1:8000;
  keepalive 32;
}

server {
  listen __BIRDLENSE_PORT__;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_types application/json application/javascript text/css text/plain text/xml application/xml;
  __BROTLI_BLOCK__

  open_file_cache max=2000 inactive=30s;
  open_file_cache_valid 120s;
  open_file_cache_min_uses 2;
  open_file_cache_errors on;

  # Защита от path traversal
  if ($request_uri ~* "\.\.") { return 403; }

  # #339: не отдаём весь DATA_DIR — иначе скачиваем SQLite (db/), датасет, кэш без auth.
  # Прямая раздача recordings (по умолчанию вкл.); откл.: BIRDLENSE_HIDE_DIRECT_RECORDINGS=1 → placeholder пустой, /data/recordings/* → 403.
  __RECORDINGS_LOCATION_BLOCK__
  location ^~ /data/images/ {
    alias /app/data/images/;
    autoindex off;
    add_header Accept-Ranges bytes;
  }
  location ^~ /data/file_test/ {
    alias /app/data/file_test/;
    autoindex off;
    add_header Accept-Ranges bytes;
  }
  location ^~ /data/ {
    return 403;
  }

  location / {
    root /usr/share/nginx/html;
    index index.html;
    try_files $uri $uri/ /index.html;
  }

  # MP4 по Range — без буферизации nginx (иначе долгий старт и лишняя память)
  location ~ ^/api/ui/videos/[0-9]+/stream$ {
    proxy_pass http://birdlense_web;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 90s;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location /api {
    proxy_pass http://birdlense_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 90s;
    proxy_read_timeout 24h;
    proxy_send_timeout 24h;
    proxy_request_buffering off;
  }

  # Prometheus metrics for Grafana
  location /metrics {
    proxy_pass http://birdlense_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 90s;
  }

  # MCP (Model Context Protocol) — при mcp.enabled
  location /mcp {
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Accept $http_accept;
    proxy_pass_request_headers on;
    proxy_read_timeout 86400;
    proxy_buffering off;
  }
  # Cursor fallback на SSE — тот же endpoint
  location /sse {
    rewrite ^/sse(.*)$ /mcp$1 break;
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Accept $http_accept;
    proxy_pass_request_headers on;
    proxy_read_timeout 86400;
    proxy_buffering off;
  }

  # MJPEG от процессора: камера 0 = 8082, 1 = 8083, … 9 = 8091
  location /processor/live {
    proxy_pass http://127.0.0.1:8082;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header Connection close;
  }
  location = /processor/live/0 { proxy_pass http://127.0.0.1:8082; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/1 { proxy_pass http://127.0.0.1:8083; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/2 { proxy_pass http://127.0.0.1:8084; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/3 { proxy_pass http://127.0.0.1:8085; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/4 { proxy_pass http://127.0.0.1:8086; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/5 { proxy_pass http://127.0.0.1:8087; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/6 { proxy_pass http://127.0.0.1:8088; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/7 { proxy_pass http://127.0.0.1:8089; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/8 { proxy_pass http://127.0.0.1:8090; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }
  location = /processor/live/9 { proxy_pass http://127.0.0.1:8091; proxy_http_version 1.1; proxy_buffering off; proxy_set_header Host $host; proxy_set_header Connection close; }

  location /go2rtc/ {
    rewrite ^/go2rtc/(.*)$ /$1 break;
    proxy_pass http://__GO2RTC_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
  }
}
