# BirdLense Hub — один контейнер
# Go2RTC upstream — из video.go2rtc_url (http://IP:1984)

resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 8080;

  # Защита от path traversal
  if ($request_uri ~* "\.\.") { return 403; }

  location /data/ {
    alias /app/data/;
    autoindex off;
    add_header Accept-Ranges bytes;
  }

  location / {
    root /usr/share/nginx/html;
    index index.html;
    try_files $uri $uri/ /index.html;
  }

  location /api {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # Prometheus metrics for Grafana
  location /metrics {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # MCP (Model Context Protocol) — при mcp.enabled
  location /mcp {
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Accept $http_accept;
    proxy_pass_request_headers on;
    proxy_read_timeout 86400;
    proxy_buffering off;
  }
  # Cursor fallback на SSE — тот же endpoint
  location /sse {
    rewrite ^/sse(.*)$ /mcp$1 break;
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Accept $http_accept;
    proxy_pass_request_headers on;
    proxy_read_timeout 86400;
    proxy_buffering off;
  }

  location /processor/live {
    proxy_pass http://127.0.0.1:8082;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header Connection close;
  }

  location ~ ^/processor/live/([0-9]+)$ {
    proxy_pass http://127.0.0.1:8082;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header Connection close;
  }

  location /go2rtc/ {
    rewrite ^/go2rtc/(.*)$ /$1 break;
    proxy_pass http://__GO2RTC_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
  }
}
