FROM nvcr.io/nvidia/l4t-base:r32.7.1

ARG MAMBA_ARCH=aarch64
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH=/opt/conda/envs/birdlense/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bzip2 ca-certificates curl ffmpeg gosu nginx \
    build-essential python3-dev \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-libav \
    libgl1 libglib2.0-0 libgomp1 libjpeg-turbo8 libpng16-16 libsm6 libtiff5 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-linux-${MAMBA_ARCH}" \
      -o /usr/local/bin/micromamba \
    && chmod +x /usr/local/bin/micromamba \
    && mkdir -p /opt/conda \
    && micromamba create -y -n birdlense -c conda-forge \
      python=3.11 pip numpy opencv onnx onnxruntime pyyaml pydantic requests paramiko \
    && micromamba clean -a -y

WORKDIR /app

# Copy application code
COPY app/data/images /app/_bundled_data/images
COPY app/ebird_region_core.py ./
COPY app/web/ ./web/
COPY app/shared/ ./shared/
COPY app/processor/ ./processor/
COPY app/app_config/ ./app_config/
COPY app/scripts/ ./scripts/
COPY scripts/internal/reid/run_daily_ssl_cycle.py ./scripts/reid/

COPY app/processor/requirements-jetson.txt /tmp/processor-requirements.jetson.txt
RUN python3 -m pip install --default-timeout=600 --no-cache-dir -r web/requirements.txt \
    && python3 -m pip install --default-timeout=600 --no-cache-dir -r /tmp/processor-requirements.jetson.txt

# UI статика + nginx template для entrypoint bootstrap.
COPY app/ui/dist /usr/share/nginx/html
COPY app/nginx/standalone.conf.template /etc/nginx/conf.d/default.conf.template

# Strip brotli from nginx main to avoid missing module
COPY app/nginx/docker-nginx-main.conf /app/nginx/docker-nginx-main.conf
RUN sed -i '/ngx_http_brotli_/d' /app/nginx/docker-nginx-main.conf

# Create non-root user
RUN groupadd -r birdlense -g 1000 \
    && useradd -r -u 1000 -g birdlense -d /app -s /bin/bash birdlense \
    && mkdir -p /var/log/nginx \
    && chown -R birdlense:birdlense /app /usr/share/nginx/html /etc/nginx/conf.d /var/log/nginx 2>/dev/null || true

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://127.0.0.1:8000/api/ui/health > /dev/null || exit 1

EXPOSE 8080
ENV API_URL_BASE=http://127.0.0.1:8000/api/processor
ENV DATA_DIR=/app/data
ENV PYTHONPATH=/app/processor/src:/app/web:/app/shared
ENV LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/tegra
ENV YOLO_CONFIG_DIR=/app/data/.ultralytics
ENV OPENCV_LOG_LEVEL=ERROR
ENV OPENCV_FFMPEG_LOGLEVEL=quiet
ENV BIRDLENSE_PLATFORM=jetson_nano
ENV BIRDLENSE_INFERENCE_BACKEND=tensorrt
ENV BIRDLENSE_BINARY_TENSORRT_PATH=models/detection/trapper_ai_v02_2024/trapper_ai_v02_2024.engine
ENV BIRDLENSE_CLASSIFIER_ENGINE=chriamue
ENV BIRDLENSE_CLASSIFIER_INFERENCE_BACKEND=onnxruntime
ENV HF_HUB_DISABLE_XET=1
ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1

CMD ["/bin/bash", "/app/scripts/entrypoint.sh"]