# BirdLense environment variables
# Copy to .env and fill in your values ( .env не коммитится )

# Production: после FLASK_SECRET_KEY и PROCESSOR_SECRET раскомментируйте обе строки.
# BIRDLENSE_ENV=production
# BIRDLENSE_STRICT_API_AUTH=1

# Кэш API (TTL): в Docker по умолчанию redis://redis:6379/0 (сервис redis в docker-compose.yml).
# Вне compose: задайте свой URL. Пустая строка / не задавать вне Docker — in-memory в процессе.
# REDIS_URL=redis://192.168.1.10:6379/0

# БД: по умолчанию SQLite в DATA_DIR. Для высокой записи — PostgreSQL, например:
# DATABASE_URL=postgresql+psycopg://birdlense:secret@postgres:5432/birdlense
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=15

# Для продакшена: уникальный ключ для сессии (защита настроек)
# FLASK_SECRET_KEY=your-random-secret-here

# Защита API processor (create_video, activity_log и др.). Если задан — processor
# отправляет X-Processor-Token. Рекомендуется для публичного доступа.
# PROCESSOR_SECRET=your-random-secret-min-16-chars

# Порт веб-интерфейса (по умолчанию 8085)
# BIRDLENSE_PORT=8085

# Публичный/VPS доступ: не отдавать предсказуемые URL /data/recordings/... без API (nginx не добавляет location).
# Воспроизведение: /api/ui/videos/:id/stream. LAN с прямыми ссылками — не включать.
# BIRDLENSE_HIDE_DIRECT_RECORDINGS=1

# Gunicorn (gthread): число потоков на один воркер. По умолчанию 16 (entrypoint.sh).
# GUNICORN_THREADS=24

# CORS — локальная разработка (Vite, birdlense.local, порт хаба). Дефолт задан в config; пустая строка = не добавлять
# CORS_LOCAL_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CORS — базовые origins по умолчанию (если нужен публичный домен/демо без runtime-переопределения)
# CORS_DEFAULT_ORIGINS=https://demo.example.com,http://demo.example.com

# CORS — доп. origins для доступа к API (через запятую)
# CORS_ORIGINS=http://192.168.1.11:8085,http://192.168.1.11:80

# Go2RTC URL (if not in same docker network as birdlense)
# GO2RTC_URL=http://192.168.1.100:1984

# MQTT (for Stage 2 - Frigate/BirdNET)
# MQTT_BROKER=mqtt.local
# MQTT_PASSWORD=

# Home Assistant (weather, feeder)
# Home Assistant (общий REST API: погода, весы с source=homeassistant и др.; см. Настройки → Home Assistant)
# HA_URL=http://homeassistant:8123
# HA_TOKEN=your_long_lived_token

# OpenWeather (for weather in UI)
# OPENWEATHER_API_KEY=

# MCP — токен для доступа к /mcp (переопределяет mcp.token в конфиге)
# MCP_TOKEN=your-secret-token-min-16-chars

# Строгий режим /api/ui/* в production: нужны сессия, MCP Bearer или BIRDLENSE_UI_API_KEY
# BIRDLENSE_UI_API_KEY=your-random-ui-api-secret

# Xeno-canto API v3 — ключ для воспроизведения птичьих песен. По умолчанию demo (ограничения).
# Зарегистрируйтесь на xeno-canto.org для своего ключа.
# XENO_CANTO_API_KEY=your-api-key

# Hugging Face — для загрузки датасетов (huggingface-cli, Python). НЕ КОММИТИТЬ!
# HF_TOKEN=hf_xxxxxxxxxxxx

# История метрик для страницы «Система» (SQLite, фоновый sampler). По умолчанию 30 с и 72 ч.
# BIRDLENSE_SYSTEM_METRICS_INTERVAL_SEC=30
# BIRDLENSE_SYSTEM_METRICS_RETENTION_HOURS=72
# Тесты/CI: отключить фоновую запись — DISABLE_SYSTEM_METRICS_SAMPLER=1

# За доверенным reverse proxy (только nginx до приложения): учитывать X-Real-IP / X-Forwarded-For
# в rate limit. На публичном HTTPS обычно TRUSTED_PROXY=1.
# TRUSTED_PROXY=1

# Инференс (перекрывают default_config / user_config; после смены — docker compose up -d --force-recreate).
# Прод-стек: NABirds + OpenVINO (parity gate — docs/ml/MODEL_EXPORT_GUIDE.md, make sync-models).
BIRDLENSE_INFERENCE_BACKEND=openvino
BIRDLENSE_OPENVINO_BINARY_ENABLED=1
BIRDLENSE_INFERENCE_DEVICE=intel:gpu
BIRDLENSE_CLASSIFIER_INFERENCE_BACKEND=openvino
BIRDLENSE_CLASSIFIER_INFERENCE_DEVICE=intel:gpu
# Экстренный откат на PyTorch CPU:
# BIRDLENSE_INFERENCE_BACKEND=torch
# BIRDLENSE_OPENVINO_BINARY_ENABLED=0
# BIRDLENSE_INFERENCE_DEVICE=cpu
# OMP_NUM_THREADS=4
# Ещё ниже порогов, чем CONFIDENCE_FLOORS в default (редко):
# BIRDLENSE_SKIP_CONFIDENCE_FLOORS=1

# Секреты из env (перекрывают значения из user_config после merge; см. docs/CONFIGURATION.md, #278).
# Непустое значение подставляется в рантайм-конфиг; в YAML можно оставить плейсхолдеры.
# Пароли UI: в env можно задать plaintext или bcrypt-хеш ($2a$/$2b$/$2y$); при сохранении из UI новые пароли хешируются.
# BIRDLENSE_TELEGRAM_BOT_TOKEN=
# BIRDLENSE_TELEGRAM_MTPROTO_SECRET=
# BIRDLENSE_TELEGRAM_API_HASH=
# BIRDLENSE_HA_TOKEN=
# BIRDLENSE_SETTINGS_PASSWORD=
# BIRDLENSE_CONTRIBUTOR_PASSWORD=
# BIRDLENSE_MQTT_PASSWORD=
# BIRDLENSE_GO2RTC_PASSWORD=
# BIRDLENSE_OPENWEATHER_API_KEY=
# BIRDLENSE_EBIRD_API_KEY=
# BIRDLENSE_XENO_CANTO_API_KEY=
# BIRDLENSE_MCP_TOKEN=
# BIRDLENSE_VAPID_PRIVATE_KEY=
# BIRDLENSE_REDIS_URL=
# Опционально: перекрыть пароль/пасфразу зеркала SFTP из UI (storage.recordings_mirror) только в рантайме
# BIRDLENSE_RECORDINGS_MIRROR_SFTP_PASSWORD=
# BIRDLENSE_RECORDINGS_MIRROR_SFTP_KEY_PASSPHRASE=

# Старт Hub: тяжёлые задачи по умолчанию выключены (см. docs/CONFIGURATION.md).
# BIRDLENSE_STARTUP_BACKFILL_SPECIES_TAXA=1
# BIRDLENSE_STARTUP_CLEANUP_LEGACY_IMPORT=1
# BIRDLENSE_STARTUP_REPAIR_SPECIES_METADATA=1
# BIRDLENSE_NOTIFY_APP_STARTUP=0

# Daily offline SSL/Re-ID cycle inside container (no host cron required).
# Set ENABLED=1 to run scheduler in entrypoint.
# BIRDLENSE_REID_SSL_DAILY_ENABLED=0
# BIRDLENSE_REID_SSL_DB=/app/data/db/birdlense.db
# BIRDLENSE_REID_SSL_WINDOW_HOURS=24
# BIRDLENSE_REID_SSL_LIMIT=400
# BIRDLENSE_REID_SSL_CLUSTER_THRESHOLD=0.88
# BIRDLENSE_REID_SSL_REPORT_JSON=/app/data/reid_ssl_reports/latest.json
# BIRDLENSE_REID_SSL_INTERVAL_SEC=86400
# BIRDLENSE_REID_SSL_START_DELAY_SEC=300
# BIRDLENSE_REID_SSL_UPDATE_VIDEO_NICKNAMES=1
