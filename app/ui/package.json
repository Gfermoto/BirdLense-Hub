{
  "name": "birdlense-ui",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "codegen:openapi": "openapi-typescript ../web/openapi.yaml -o src/generated/openapi-types.ts",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "preview": "vite preview",
    "docs": "node ./node_modules/typedoc/bin/typedoc",
    "coverage": "vitest --run --coverage",
    "coverage:critical": "vitest --run --coverage --config vitest.coverage-critical.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/system": "^6.5.0",
    "@mui/x-charts": "^8.28.0",
    "@mui/x-date-pickers": "^7.22.3",
    "@mui/x-tree-view": "^7.22.1",
    "@tanstack/react-form": "^0.42.1",
    "@tanstack/react-query": "^5.61.0",
    "@tanstack/react-query-devtools": "^5.61.0",
    "axios": "^1.15.0",
    "dayjs": "^1.11.13",
    "i18next": "^23.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.12.0",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "~8.55.0",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "overrides": {
    "lodash": ">=4.18.0",
    "serialize-javascript": ">=7.0.5",
    "eslint-visitor-keys": "4.2.1"
  }
}
