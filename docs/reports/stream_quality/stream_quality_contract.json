{
  "schema": "stream_quality_contract@v1",
  "detector": {
    "required_metrics": [
      "precision",
      "recall",
      "fp_hour",
      "fn_hour"
    ],
    "thresholds": {
      "min_precision": 0.3,
      "min_recall": 0.3,
      "max_fp_hour": 5.0,
      "max_fn_hour": 60.0,
      "min_tracks_coverage": 0.5,
      "max_empty_bbox_rate": 0.2,
      "max_trigger_to_first_bbox_latency_p95_s": 5.0,
      "min_sessions_total": 1
    }
  },
  "classifier": {
    "required_metrics": [
      "top1",
      "top3",
      "macro_f1",
      "ece"
    ],
    "thresholds": {
      "min_top1": 0.3,
      "min_top3": 0.3,
      "min_macro_f1": 0.3,
      "max_ece": 0.4
    }
  },
  "behavior": {
    "required_metrics": [
      "class_f1",
      "temporal_consistency"
    ],
    "thresholds": {
      "min_class_f1": 0.4,
      "min_temporal_consistency": 0.4
    }
  },
  "reid": {
    "required_metrics": [
      "link_accuracy",
      "id_switches"
    ],
    "thresholds": {
      "min_link_accuracy": 0.9,
      "max_id_switches": 0
    }
  }
}
