# BirdLense Hub — ESPHome: реле кормушки
# Шаблон. Скопировать в bird-feeder-relay.yaml и задать свои secrets.
#
# Управление кормушкой: ESP8266 (ESP-01 1M), реле на GPIO, кнопка «кормление».
# Wi‑Fi / OTA — через secrets.yaml (см. secrets.yaml.example).
#
# ВАЖНО: GPIO0 — strapping pin (режим загрузки). Надёжнее перенести реле на GPIO2/GPIO3,
# если схема платы позволяет.

substitutions:
  devicename: bird_feeder

esphome:
  name: ${devicename}
  friendly_name: "Bird Feeder"
  comment: "BirdLense — реле кормушки (ESP8266)"

esp8266:
  board: esp01_1m

logger:

web_server:
  port: 80
  version: 3

api:
  reboot_timeout: 30min
  # encryption:
  #   key: "!secret api_encryption_key"

ota:
  - platform: esphome
    password: !secret ota_password

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: "Bird Feeder Fallback Hotspot"
    password: "12345678"

captive_portal:

button:
  - platform: template
    name: "${devicename} Feeder"
    id: up
    icon: "mdi:bird"
    on_press:
      - delay: 500ms
      - switch.turn_on: relay
      - delay: 5s
      - switch.turn_off: relay

switch:
  - platform: gpio
    id: relay
    pin: GPIO0
    name: "${devicename} Switch"
    inverted: true
    internal: false

  - platform: restart
    name: "${devicename} Restart"

sensor:
  - platform: wifi_signal
    name: "${devicename} WiFi Signal"
    update_interval: 60s

  - platform: uptime
    name: "${devicename} Uptime"
    id: uptime_sensor
    update_interval: 60s

text_sensor:
  - platform: version
    name: "${devicename} ESPHome Version"
  - platform: wifi_info
    ip_address:
      name: "${devicename} IP Address"