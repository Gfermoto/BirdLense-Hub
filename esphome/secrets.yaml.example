# Скопируйте в secrets.yaml рядом с YAML при сборке и подставьте значения.
# Файл secrets.yaml не коммитьте (в .gitignore).
#
# Ключи: bird-feeder-relay.yaml, ld2450-native-zones.yaml, bird-feeder-scale.yaml.
#
# Сгенерировать ключ шифрования: openssl rand -base64 32

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ota_password: "YOUR_OTA_PASSWORD"
api_encryption_key: "YOUR_BASE64_32_BYTES_KEY"
hotspot_password: "YOUR_AP_PASSWORD"
mqtt_broker_ip: "192.168.1.10"
mqtt_username: "YOUR_MQTT_USER"
mqtt_password: "YOUR_MQTT_PASSWORD"