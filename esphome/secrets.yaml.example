# Скопируйте в secrets.yaml рядом с YAML при сборке и подставьте значения.
# Файл secrets.yaml не коммитьте.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# OTA (bird-feeder-relay и др.): пустая строка — без пароля; лучше задать свой пароль.
ota_password: ""

# Опционально (для прошивок с MQTT; bird-feeder-scale.yaml их не использует).
mqtt_broker_ip: "192.168.1.10"
mqtt_username: "mqtt"
mqtt_password: "mqtt"

# ld2450-native-zones.yaml (ESPHome API encryption + fallback AP).
# Сгенерировать ключ: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTES"
hotspot_password: "REPLACE_AP_PASSWORD"
