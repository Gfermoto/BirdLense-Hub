# Локальные настройки деплоя — скопируйте в deploy.local.sh
# cp deploy.local.sh.example deploy.local.sh
# deploy.local.sh не коммитится в git

export DEPLOY_HOST="birdlense"           # хост из ~/.ssh/config
# DEPLOY_URL — ОБЯЗАТЕЛЬНО для удалённого деплоя! Health check идёт с локальной машины.
# Без правильного URL проверка после деплоя всегда FAIL.
export DEPLOY_URL="http://192.168.1.11:8085"  # замените на IP вашего сервера

# На сервере создайте app/.env или задайте здесь (попадут в app/.env при деплое):
#   CORS_ORIGINS=http://YOUR_IP:8085  # вручную на сервере
#   MCP_TOKEN=ваш-токен-для-mcp       # при деплое запишется в app/.env
#   PROCESSOR_SECRET — генерируется автоматически при деплое, добавьте сюда для сохранения
