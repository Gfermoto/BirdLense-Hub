# Локальные настройки деплоя — скопируйте в deploy.local.sh
# cp deploy.local.sh.example deploy.local.sh
# deploy.local.sh не коммитится в git

# SSH: добавьте в ~/.ssh/config:
#   Host birdlense
#     HostName YOUR_SERVER_IP
#     Port 2222
#     User root
# (пароль — вручную при первом ssh, или настройте ключ: ssh-copy-id -p 2222 root@YOUR_SERVER_IP)

export DEPLOY_HOST="birdlense"           # хост из ~/.ssh/config
# DEPLOY_URL — ОБЯЗАТЕЛЬНО для удалённого деплоя! Health check идёт с локальной машины.
export DEPLOY_URL="http://YOUR_HOST:8085"
# Куда rsync заливает код на сервере (по умолчанию в deploy.sh: /root/BirdLense)
# export DEPLOY_REMOTE_DIR="/root/BirdLense"

# На сервере создайте app/.env или задайте здесь (попадут в app/.env при деплое):
#   CORS_ORIGINS=http://YOUR_HOST:8085
#   MCP_TOKEN=ваш-токен-для-mcp
#   PROCESSOR_SECRET — генерируется при деплое, добавьте сюда для сохранения
