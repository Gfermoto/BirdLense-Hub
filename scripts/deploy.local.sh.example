# Локальные настройки деплоя — скопируйте в deploy.local.sh
# cp scripts/deploy.local.sh.example scripts/deploy.local.sh
# deploy.local.sh не коммитится в git
#
# Важно: держите активным ОДИН режим — LAN (на площадке в той же сети) или VPS (удалённо).
# Перед поездкой на LAN / возвратом к удалёнке — переключите блоки ниже.

# =============================================================================
# Режим A — на площадке (LAN): пара дней в сети с сервером
# =============================================================================
export DEPLOY_HOST="root@192.168.1.11"
unset DEPLOY_SSH_PORT
export DEPLOY_URL="http://192.168.1.11:8085"
# CORS на сервере (app/.env): например CORS_ORIGINS=http://192.168.1.11:8085

# Или ~/.ssh/config:
#   Host birdlense-lan
#     HostName 192.168.1.11
#     Port 22
#     User root
# export DEPLOY_HOST="birdlense-lan"

# =============================================================================
# Режим B — удалённо (VPS / публичный URL): раскомментируйте и закомментируйте блок A
# =============================================================================
# unset DEPLOY_SSH_PORT
# export DEPLOY_HOST="root@185.218.111.196"
# export DEPLOY_SSH_PORT="2222"
# export DEPLOY_URL="https://birdlense.eyera.info"
# или по IP: export DEPLOY_URL="http://185.218.111.196:8085"
# CORS: https://birdlense.eyera.info

# Куда rsync заливает код на сервере (по умолчанию в deploy.sh: /root/BirdLense)
# export DEPLOY_REMOTE_DIR="/root/BirdLense"

# Секреты (make deploy сольёт в app/.env на сервере, если заданы):
# export FLASK_SECRET_KEY="..."
# export PROCESSOR_SECRET="..."
# export MCP_TOKEN="..."
# export BIRDLENSE_ENV="production"
# Публичный хаб: опционально strict UI API (#279) — см. CONFIGURATION / SECURITY
# export BIRDLENSE_STRICT_API_AUTH=1
# export BIRDLENSE_UI_API_KEY="..."   # для curl/интеграций без браузерной сессии
