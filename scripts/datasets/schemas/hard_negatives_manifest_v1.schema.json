{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "birdlense://schemas/hard_negatives_manifest_v1",
  "title": "Hard negatives manifest (static curated set, epic #367)",
  "type": "object",
  "required": ["schema", "items"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "hard_negatives_manifest@v1"
    },
    "notes": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "kind"],
        "additionalProperties": true,
        "properties": {
          "relative_path": {
            "type": "string",
            "description": "Path relative to manifest directory or dataset root"
          },
          "kind": {
            "type": "string",
            "enum": ["image_level", "object_crop"]
          },
          "source": {
            "type": "string",
            "description": "e.g. hub_export, oid, manual"
          },
          "seed": { "type": "integer" }
        }
      }
    }
  }
}
