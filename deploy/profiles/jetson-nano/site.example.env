# Скопируйте в site.env рядом с этим файлом и заполните.
# Используется scripts/jetson-setup.sh и scripts/build_jetson_user_config.py

# MQTT (Home Assistant / Mosquitto в LAN)
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=CHANGE_ME

# Go2RTC (обычно на NUC/VPS в LAN)
GO2RTC_URL=http://192.168.1.11:1984
GO2RTC_USERNAME=user
GO2RTC_PASSWORD=CHANGE_ME

# Home Assistant API (погода, кормушка)
HA_URL=http://192.168.1.10:8123

# UI: внешний URL (NAT) для уведомлений и ссылок
UI_BASE_URL=http://192.168.1.127:8085

# Пароли Hub (Settings → пароль админа / оператора)
SETTINGS_PASSWORD=CHANGE_ME
CONTRIBUTOR_PASSWORD=CHANGE_ME

# Home Assistant long-lived token (опционально)
# HA_TOKEN=

# MCP (внешние агенты)
# MCP_ENABLED=1
# MCP_TOKEN=

# API keys (опционально)
# EBIRD_API_KEY=
# OPENWEATHER_API_KEY=
# XENO_CANTO_API_KEY=
# TELEGRAM_BOT_TOKEN=
# LATITUDE=
# LONGITUDE=

# Секреты приложения (сгенерируйте: openssl rand -hex 32)
# FLASK_SECRET_KEY=
# PROCESSOR_SECRET=
