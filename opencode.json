{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openai/gpt-oss-20b:free",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "mcp": {
    "birdlense-repo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  },
  "permission": {
    "webfetch": "allow",
    "grep": "allow",
    "glob": "allow",
    "read": "allow",
    "bash": {
      "*": "ask",
      "make *": "allow",
      "cd *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow"
    }
  }
}
